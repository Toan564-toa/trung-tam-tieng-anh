# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.

NODE_ENV=development
PORT=4000

# PostgreSQL local do docker-compose.yml cung cấp (docker compose up -d)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/trung_tam?schema=public"

# Database riêng cho test, tách khỏi database phát triển. Script test sẽ tự tạo và xóa sạch trước mỗi bộ test.
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:5432/trung_tam_test?schema=public"

# Địa chỉ web frontend (React) được phép gọi API. Nhiều địa chỉ: cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173

# 'true' chỉ khi chạy sau reverse proxy (Nginx, Cloudflare...)
TRUST_PROXY=false

# Khóa ký token: chuỗi ngẫu nhiên dài >= 32 ký tự (khác nhau cho access và refresh)
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu-aaaa
JWT_REFRESH_SECRET=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu-bbbb
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Khóa tạm tài khoản khi nhập sai quá số lần cho phép
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15

# Tài khoản admin đầu tiên (dùng cho: npm run db:seed)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=DoiMatKhauNay@123